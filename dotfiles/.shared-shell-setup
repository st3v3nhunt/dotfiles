# mise puts the runtimes and tools in ~/.config/mise/config.toml on PATH
if command -v mise &> /dev/null; then
  if [[ -n "$ZSH_VERSION" ]]; then
    eval "$(mise activate zsh)"
  else
    eval "$(mise activate bash)"
  fi
fi

# Go PATH setup
if command -v go &> /dev/null; then
  export GOPATH="$(go env GOPATH)"
  export PATH="$PATH:$GOPATH/bin"
fi

export PATH="$HOME/.cargo/bin:$PATH"

# Explicitly set path
export XDG_CONFIG_HOME="$HOME/.config"

export VISUAL=nvim
export EDITOR=$VISUAL

# Ensure HOMEBREW_PREFIX is set (differs by OS and processor)
export HOMEBREW_PREFIX="$(brew --prefix)"

# Install HOMEBREW casks (apps) into user specific application directory,
# avoids need for `sudo`
export HOMEBREW_CASK_OPTS="--appdir=~/Applications"

# Add user-installed binaries to PATH
export PATH="$HOME/.local/bin:$PATH"

# Fix error 'gpg: signing failed: Inappropriate ioctl for device'
GPG_TTY=$(tty)
export GPG_TTY

# Add shell history for iex
export ERL_AFLAGS="-kernel shell_history enabled"

export GROOVY_HOME=/opt/homebrew/opt/groovy/libexec
