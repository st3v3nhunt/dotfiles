#!/usr/bin/env sh
# Run [Super-Linter](https://github.com/super-linter/super-linter/blob/main/docs/run-linter-locally.md)
# locally, using the same version and settings as .github/workflows/main.yml
IMAGE=ghcr.io/super-linter/super-linter:slim-v8.7.0

docker pull "$IMAGE"
docker run --rm \
  -e RUN_LOCAL=true \
  -e DEFAULT_BRANCH=main \
  -e FILTER_REGEX_EXCLUDE='(CHANGELOG\.md|\.git-completion\.bash|\.git-prompt\.sh|\.p10k\.zsh|karabiner\.json|windows-terminal.*\.json|lazy-lock\.json|package-lock\.json)' \
  -e VALIDATE_BIOME_FORMAT=false \
  -e VALIDATE_NATURAL_LANGUAGE=false \
  "$@" \
  -v "$(pwd)":/tmp/lint \
  "$IMAGE"
